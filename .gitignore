.DS_Store
*.app/
*.log

# Personal Claude Code settings (the shared .claude/settings.json IS committed)
.claude/settings.local.json

# release artifacts (built by the release workflow / npm run pack)
*.clapp
*.clapp.sha256

# The assembled Clatch depot — clatch.json + bin/ + assets/, built by
# scripts/package.sh. This, not dist/, is what `clatch validate` / `clatch pack` read.
/pkg/

# Build output. dist/ is VITE's (src-tauri/tauri.conf.json frontendDist), build/ is
# scratch for the macOS dev .app wrappers.
dist/
build/
node_modules/
src-tauri/target/
src-tauri/gen/

# The retired Swift implementation, kept as the behavioural reference (native/).
native/.build/
native/build/
