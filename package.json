{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "description": "chess-template — a Clatch app with a native macOS GUI and an agent CLI, kept in sync over one shared state.",
  "scripts": {
    "build": "swift build -c release --package-path native",
    "verify": "scripts/verify.sh",
    "rename": "scripts/rename.sh",
    "package": "scripts/package.sh",
    "validate": "scripts/package.sh >/dev/null && clatch validate dist",
    "pack": "scripts/package.sh >/dev/null && clatch pack dist",
    "icon": "swift scripts/render-icon.swift",
    "dev-app": "scripts/macos-dev-app.sh",
    "shortcut:macos": "scripts/macos-shortcut.sh",
    "cli": "bin/chess"
  }
}
