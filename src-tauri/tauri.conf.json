{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chess",
  "version": "0.2.0",
  "identifier": "com.arfium.chess",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chess",
        "width": 576,
        "height": 772,
        "minWidth": 576,
        "minHeight": 772,
        "maxWidth": 576,
        "maxHeight": 772,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "../assets/icon.png"
    ]
  }
}
