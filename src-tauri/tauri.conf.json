{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chess",
  "version": "0.2.0",
  "identifier": "com.arfium.chess",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "chess", "width": 600, "height": 760, "minWidth": 520, "minHeight": 680, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["../assets/icon.png"] }
}
